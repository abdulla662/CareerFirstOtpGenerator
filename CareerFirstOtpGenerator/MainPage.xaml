<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CareerFirstOtpGenerator.MainPage"
             x:Name="PageRoot"
             BackgroundColor="#040918">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- App Header -->
        <Grid Grid.Row="0" Padding="20,52,20,16" ColumnDefinitions="Auto,*,Auto">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 100"
                        BackgroundColor="#12182A"
                        Stroke="Transparent"
                        Padding="10,6">
                    <Label x:Name="LangBtn"
                           FontFamily="CairoBold"
                           FontSize="12"
                           TextColor="#0B7A75">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageToggle"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border StrokeShape="RoundRectangle 100"
                        BackgroundColor="#12182A"
                        Stroke="Transparent"
                        Padding="10,6">
                    <Label x:Name="ThemeBtn"
                           Text="🌙"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemeToggle"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>

            <Image Grid.Column="2"
                   Source="logo.png"
                   HeightRequest="32"
                   WidthRequest="60"
                   Aspect="AspectFit"
                   HorizontalOptions="End"/>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0" Spacing="0">

                <Label x:Name="SecureVerificationLabel"
                       FontFamily="CairoBold"
                       FontSize="11"
                       TextColor="#0B7A75"
                       CharacterSpacing="2"
                       Margin="0,24,0,16"/>

                <Label x:Name="TitleLabel"
                       FontFamily="CairoBold"
                       FontSize="30"
                       TextColor="#FFFFFF"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,8"/>

                <Label x:Name="SubtitleLabel"
                       FontFamily="CairoRegular"
                       FontSize="14"
                       TextColor="#9E9CA1"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,40"/>

                <Label x:Name="OtpPasswordLabel"
                       FontFamily="CairoBold"
                       FontSize="12"
                       TextColor="#9E9CA1"
                       Margin="0,0,0,12"/>

                <!-- OTP Digit Boxes -->
                <Grid ColumnDefinitions="*,8,*,8,*,16,*,8,*,8,*"
                      HeightRequest="64"
                      Margin="0,0,0,20">
                    <Border Grid.Column="0" x:Name="Box1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit1" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="2" x:Name="Box2"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit2" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="4" x:Name="Box3"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit3" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="6" x:Name="Box4"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit4" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="8" x:Name="Box5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit5" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="10" x:Name="Box6"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#090F20"
                            Stroke="#0E122B"
                            StrokeThickness="1">
                        <Label x:Name="Digit6" FontFamily="CairoBold" FontSize="28"
                               TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Expiry Timer -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <Label x:Name="CountdownLabel"
                           Grid.Column="0"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="#0B7A75"
                           VerticalOptions="Center"
                           Margin="0,0,8,0"/>
                    <Label x:Name="ExpiresLabel"
                           Grid.Column="1"
                           FontFamily="CairoRegular"
                           FontSize="13"
                           TextColor="#9E9CA1"
                           HorizontalOptions="End"
                           VerticalOptions="Center"/>
                </Grid>

                <ProgressBar x:Name="TimerProgress"
                             Progress="1"
                             ProgressColor="#0B7A75"
                             BackgroundColor="#12182A"
                             HeightRequest="4"
                             Margin="0,0,0,40"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Generate Button -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,48" Spacing="16">
            <Button x:Name="GenerateBtn"
                    Clicked="GenerateBtn_Clicked"
                    BackgroundColor="#0B7A75"
                    TextColor="#000000"
                    FontFamily="CairoBold"
                    FontSize="16"
                    CornerRadius="100"
                    HeightRequest="52"/>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="🛡" FontSize="11" TextColor="#2A2E3E" VerticalOptions="Center"/>
                <Label x:Name="FootnoteLabel"
                       FontFamily="CairoRegular"
                       FontSize="11"
                       TextColor="#2A2E3E"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>